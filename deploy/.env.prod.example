# Продакшн-переменные. Скопируйте в .env и заполните.
# ВАЖНО: .env не коммитить.

# Домен для Caddy. Если домена нет — используйте <IP>.sslip.io
# Пример: MEDAX_DOMAIN=203.0.113.10.sslip.io
MEDAX_DOMAIN=example.sslip.io

# Доступ к дашборду (HTTP Basic). Обязательно.
MEDAX_AUTH_USER=medax
MEDAX_AUTH_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Хранилище: sqlite (по умолчанию) или postgres
MEDAX_DB_BACKEND=sqlite
# MEDAX_DB_BACKEND=postgres
# MEDAX_DATABASE_URL=postgresql://medax:password@db:5432/medax

# User-Agent бота для модуля 2 (когда он будет включён)
MEDAX_USER_AGENT=MedAXRadarBot/4.0 (+https://medaxgroup.ru/; compliance@medaxgroup.ru)
